generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id             String         @id @default(uuid())
  nome           String
  email          String         @unique
  senha          String
  role           String         @default("PROFESSOR") // "ADMIN" | "PROFESSOR"
  disciplina     String?
  campus         String?        @default("Jaraguá do Sul")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  turmas         Turma[]
  questoes       Questao[]
  provasMontadas ProvaMontada[]
  leiturasOMR    LeituraOMR[]
  resultados     ResultadoAvaliacao[]

  @@map("usuarios")
}

model Turma {
  id             String         @id @default(uuid())
  nome           String
  curso          String         @default("Engenharia de Software")
  semestre       String         @default("2026/2")
  fase           String?        @default("1ª Fase")
  codigoConvite  String         @unique
  professorId    String?
  professor      Usuario?       @relation(fields: [professorId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  alunos         Aluno[]
  provasMontadas ProvaMontada[]
  leiturasOMR    LeituraOMR[]
  questoes       Questao[]

  @@index([professorId])
  @@index([semestre])
  @@map("turmas")
}

model Aluno {
  id        String   @id @default(uuid())
  nome      String
  ra        String   @unique
  curso     String   @default("Engenharia de Software")
  turno     String   @default("Noturno")
  n1        Float    @default(0.0)
  n2        Float    @default(0.0)
  n3        Float    @default(0.0)
  contato   Json?
  endereco  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  turmaId   String
  turma     Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  leiturasOMR LeituraOMR[]

  @@index([turmaId])
  @@map("alunos")
}

model Questao {
  id           String        @id @default(uuid())
  tipo         String        @default("objetiva") // "objetiva" | "discursiva"
  enunciado    String
  pontuacao    Float         @default(2.5)
  tags         String[]
  turmaId      String?
  professorId  String?
  avaliacao    String?       @default("N2") // "N1" | "N2" | "N3" | "N-1" | "GERAL"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  turma        Turma?        @relation(fields: [turmaId], references: [id], onDelete: SetNull)
  professor    Usuario?      @relation(fields: [professorId], references: [id], onDelete: SetNull)
  alternativas Alternativa[]

  @@index([turmaId])
  @@index([professorId])
  @@index([avaliacao])
  @@map("questoes")
}

model Alternativa {
  id            String   @id @default(uuid())
  letraOriginal String   // "A", "B", "C", "D", "E"
  texto         String
  correta       Boolean  @default(false)

  questaoId     String
  questao       Questao  @relation(fields: [questaoId], references: [id], onDelete: Cascade)

  @@index([questaoId])
  @@map("alternativas")
}

model ProvaMontada {
  id                  String       @id @default(uuid())
  titulo              String
  disciplina          String?
  semestre            String?      @default("2026/2")
  ciclo               String       @default("N2") // "N1" | "N2" | "N3" | "N-1"
  turmaId             String
  professorId         String?
  questoesSnapshot    Json         // Snapshot estruturado das questões sorteadas com alternativas e gabarito
  totalQuestoes       Int          @default(0)
  pontuacaoTotal      Float        @default(10.0)
  shuffleQuestoes     Boolean      @default(true)
  shuffleAlternativas Boolean      @default(true)
  nominalQrCode       Boolean      @default(true)
  status              String       @default("PRONTA_PARA_APLICAR") // "RASCUNHO" | "PRONTA_PARA_APLICAR" | "FINALIZADA"
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  turma               Turma        @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  professor           Usuario?     @relation(fields: [professorId], references: [id], onDelete: SetNull)
  leiturasOMR         LeituraOMR[]
  cadernos            CadernoProva[]
  resultados          ResultadoAvaliacao[]

  @@index([turmaId])
  @@index([professorId])
  @@index([ciclo])
  @@map("provas_montadas")
}

model CadernoProva {
  id                  String       @id @default(uuid())
  provaMontadaId      String       @map("prova_montada_id")
  codigoVersao        String       @map("codigo_versao") // 'CADERNO-A', 'CADERNO-B' ou RA/Nome
  alunoNome           String?      @map("aluno_nome")
  alunoRa             String?      @map("aluno_ra")
  mapaQuestoesJson    Json         @map("mapa_questoes_json")
  gabaritoOficialJson Json         @map("gabarito_oficial_json")
  createdAt           DateTime     @default(now()) @map("created_at")

  provaMontada        ProvaMontada @relation(fields: [provaMontadaId], references: [id], onDelete: Cascade)
  resultados          ResultadoAvaliacao[]

  @@index([provaMontadaId])
  @@index([codigoVersao])
  @@map("cadernos_prova")
}

model ResultadoAvaliacao {
  id                    String        @id @default(uuid())
  professorId           String        @map("professor_id")
  provaMontadaId        String        @map("prova_montada_id")
  cadernoProvaId        String?       @map("caderno_prova_id")
  alunoNome             String        @map("aluno_nome")
  alunoRa               String?       @map("aluno_ra")
  respostasMarcadasJson Json          @map("respostas_marcadas_json")
  acertos               Int
  totalQuestoes         Int           @map("total_questoes")
  notaFinal             Float         @map("nota_final")
  lidoViaMobile         Boolean       @default(true) @map("lido_via_mobile")
  createdAt             DateTime      @default(now()) @map("created_at")

  professor             Usuario       @relation(fields: [professorId], references: [id], onDelete: Cascade)
  provaMontada          ProvaMontada  @relation(fields: [provaMontadaId], references: [id], onDelete: Cascade)
  cadernoProva          CadernoProva? @relation(fields: [cadernoProvaId], references: [id], onDelete: SetNull)

  @@index([professorId])
  @@index([provaMontadaId])
  @@index([cadernoProvaId])
  @@index([alunoRa])
  @@index([createdAt])
  @@map("resultados_avaliacao")
}

model LeituraOMR {
  id                  String        @id @default(uuid())
  alunoId             String
  alunoNome           String
  ra                  String
  turmaId             String?
  professorId         String?
  provaMontadaId      String?
  turmaNome           String
  materia             String
  versao              String
  acertos             Int
  totalQuestoes       Int
  notaCalculada       Float
  dataLeitura         String
  respostasDetectadas Json          // Record<number, string | null>
  gabaritoOficial     Json?         // Record<number, string>
  detalhesQuestoes    Json?         // OMRQuestionResult[]
  fiduciaisDetectados Boolean?      @default(true)
  createdAt           DateTime      @default(now())

  aluno               Aluno         @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  turma               Turma?        @relation(fields: [turmaId], references: [id], onDelete: SetNull)
  professor           Usuario?      @relation(fields: [professorId], references: [id], onDelete: SetNull)
  provaMontada        ProvaMontada? @relation(fields: [provaMontadaId], references: [id], onDelete: SetNull)

  @@index([alunoId])
  @@index([turmaId])
  @@index([professorId])
  @@index([provaMontadaId])
  @@index([createdAt])
  @@map("leituras_omr")
}
